# ============================================
# HushPay Environment Variables
# ============================================
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================

# ============================================
# SMART CONTRACT DEPLOYMENT (packages/contracts)
# ============================================

# Polygon PoS Mainnet RPC URL
# Get from: https://docs.polygon.technology/pos/reference/rpc-endpoints/
# Or use Alchemy/Infura/QuickNode
POLYGON_RPC_URL=https://polygon-rpc.com

# Deployer wallet private key (WITHOUT 0x prefix)
# This wallet needs MATIC for gas fees
# NEVER share this key or commit it to git
DEPLOYER_PRIVATE_KEY=your-private-key-here-never-commit

# PolygonScan API key for contract verification
# Get from: https://polygonscan.com/apis
POLYGONSCAN_API_KEY=

# Fee recipient address (receives protocol fees)
FEE_RECIPIENT_ADDRESS=

# Fee in basis points (100 = 1%, max 100)
FEE_BPS=50

# ============================================
# FRONTEND (apps/web)
# ============================================

# Dynamic.xyz Environment ID
# Get from: https://dynamic.xyz dashboard
VITE_DYNAMIC_ENVIRONMENT_ID=your-dynamic-environment-id

# Alchemy API Key (optional, for better RPC)
VITE_ALCHEMY_API_KEY=your-alchemy-api-key

# Chain configuration
VITE_CHAIN_ID=137

# Native USDC on Polygon PoS Mainnet
VITE_USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# V1 Contract
VITE_CONTRACT_ADDRESS=0xa961a614CDB8721ccb168cd453d675cAFd4Ee5cC

# V2 Contracts (Polygon Mainnet)
VITE_INVOICES_V2_ADDRESS=0x87B7b40e7f2914B3d5b689AAF4418e1AD7084630
VITE_DISPUTES_ADDRESS=0x90EC2789Eec7381Bc11EAC5AF7B0804e75D1F68a
VITE_MILESTONES_ADDRESS=0xd36De25daeE4Dc1D54c530FE25aD03a195FDf642
VITE_MERCHANT_REGISTRY_ADDRESS=0x26b1ea9Bb8Aa33086Fa5b4D32EA89b2Da6DD4B14
VITE_FEE_MANAGER_ADDRESS=0x0a1B6ab1Ee210425EDDe4628d5250411aBF4748E

# App URL for generating payment links
VITE_APP_URL=http://localhost:5173

# ============================================
# OPTIONAL: IPFS for memo storage
# ============================================

# Pinata API keys (optional - for storing invoice metadata on IPFS)
# Get from: https://pinata.cloud
VITE_PINATA_API_KEY=
VITE_PINATA_SECRET_KEY=
