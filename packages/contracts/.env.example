# Environment variables for packages/contracts
# Copy to .env and fill in values

# Polygon PoS Mainnet RPC URL
# Options: https://polygon-rpc.com, Alchemy, Infura, QuickNode
POLYGON_RPC_URL=https://polygon-rpc.com

# Deployer wallet private key (WITHOUT 0x prefix)
# This wallet needs MATIC for gas fees
# NEVER share or commit this key
DEPLOYER_PRIVATE_KEY=

# PolygonScan API key for contract verification
# Get from: https://polygonscan.com/apis
POLYGONSCAN_API_KEY=

# Fee recipient address (receives protocol fees)
# Defaults to deployer address if not set
FEE_RECIPIENT_ADDRESS=

# Fee in basis points (100 = 1%, max 100)
FEE_BPS=50
