# Environment variables for apps/web
# Copy to .env.local and fill in values

# Dynamic.xyz Environment ID (required)
VITE_DYNAMIC_ENVIRONMENT_ID=00149423-5def-430a-9d3c-d38afb5977b5

# Chain configuration
VITE_CHAIN_ID=137

# Native USDC on Polygon PoS Mainnet
VITE_USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# HushPayInvoices contract address (required - set after deployment)
VITE_INVOICE_CONTRACT_ADDRESS=

# App URL for generating payment links
VITE_APP_URL=http://localhost:5173

# Optional: IPFS for storing invoice metadata
VITE_PINATA_API_KEY=
VITE_PINATA_SECRET_KEY=
